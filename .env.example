APP_NAME=NirwethX ReviewFlow API
ENVIRONMENT=development
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
# Use PostgreSQL in production. SQLite works for local development.
DATABASE_URL=sqlite:///./reviewflow.db
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
IP_HASH_SECRET=replace-this-too
